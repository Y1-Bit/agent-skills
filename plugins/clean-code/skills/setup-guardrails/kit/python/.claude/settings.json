{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "uv run ruff format --quiet . && uv run ruff check --fix --quiet . || true" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "./scripts/agent_gate.sh" }] }
    ]
  }
}
